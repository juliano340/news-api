    "axios": "^1.13.5",
    "better-sqlite3": "^12.6.2",
    "dotenv": "^17.3.1",
    "fast-glob": "^3.3.3",
    "fastify": "^5.7.4",
    "gray-matter": "^4.0.3",
    "node-cron": "^4.2.1",
    "rss-parser": "^3.13.0",
    "slugify": "^1.6.6"
  }
