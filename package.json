{
  "name": "news-api",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "node index.js",
    "collect": "node -e \"require('./src/lib/db').init(); require('./src/services/collector').runCollection().then((r)=>{console.log(JSON.stringify(r,null,2)); process.exit(0);}).catch((e)=>{console.error(e); process.exit(1);});\"",
    "migrate:legacy:dry": "node scripts/migrate-from-github.js --dry-run",
    "migrate:legacy": "node scripts/migrate-from-github.js"
  },
  "keywords": [],
